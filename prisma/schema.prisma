generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String?
  avatar        String?
  balance       Float     @default(100000)
  riskTolerance String    @default("moderate")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  portfolios    Portfolio[]
  trades        Trade[]
  notifications Notification[]
  aiLogs        AITrainingLog[]
}

model Portfolio {
  id         String   @id @default(cuid())
  userId     String
  symbol     String
  name       String
  quantity   Float    @default(0)
  avgPrice   Float    @default(0)
  currentPrice Float  @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol])
}

model Trade {
  id          String   @id @default(cuid())
  userId      String
  symbol      String
  action      String   // BUY, SELL, HOLD
  quantity    Float
  price       Float
  totalValue  Float
  profitLoss  Float    @default(0)
  aiSignal    String?  // STRONG_BUY, BUY, HOLD, SELL, STRONG_SELL
  confidence  Float    @default(0)
  strategy    String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AITrainingLog {
  id           String   @id @default(cuid())
  userId       String?
  episode      Int
  totalReward  Float
  epsilon      Float
  loss         Float
  accuracy     Float
  strategy     String?
  marketCondition String?
  notes        String?
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   // TRADE, ALERT, AI_SIGNAL, RISK, SYSTEM
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BacktestResult {
  id              String   @id @default(cuid())
  symbol          String
  startDate       DateTime
  endDate         DateTime
  initialBalance  Float
  finalBalance    Float
  totalReturn     Float
  sharpeRatio     Float
  maxDrawdown     Float
  winRate         Float
  totalTrades     Int
  strategy        String
  results         String   // JSON string of trade results
  createdAt       DateTime @default(now())
}

model MarketData {
  id        String   @id @default(cuid())
  symbol    String
  date      DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float
  adjClose  Float?
  createdAt DateTime @default(now())

  @@unique([symbol, date])
}

model SentimentData {
  id          String   @id @default(cuid())
  symbol      String
  source      String   // NEWS, TWITTER, REDDIT
  sentiment   Float    // -1 to 1
  confidence  Float
  headline    String?
  summary     String?
  createdAt   DateTime @default(now())
}
